# SERA ACADEMY — Environment Configuration
# Copy to .env for local or Vercel deployment. Never commit .env to GitHub.

# Application URL (used for self-referential links and password reset links)
APP_URL="http://localhost:3000"

# Session & Signed URL Signing Secret (generate a strong 64-char hex string in production)
SESSION_SECRET=

# Optional: Supabase PostgreSQL & Private Storage Integration
# Leave blank to run with the built-in persistent SQLite database & local private storage.
# Populate these for production Supabase PostgreSQL + Supabase Private Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET="course-videos"
SUPABASE_RESOURCE_BUCKET="course-resources"

# Optional: Telegram Bot API for Automated Channel Membership Verification
# Add your Telegram Bot as an Administrator in your course Telegram channels.
TELEGRAM_BOT_TOKEN=

# Optional: Initial Admin Bootstrap Credentials (for automated/headless deployment)
# If left empty, the first user to complete /auth/admin-setup becomes the Admin (one-time lock).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
